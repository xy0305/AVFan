+// R-32 (fork audiounit port): independent reset.  Stock aliases
+// .reset to stop() (AudioOutputUnitStop; the unit must be restarted
+// by a later start()).  The fork's reset refreshes the latency
+// reading and calls AudioUnitReset WITHOUT stopping the unit, so a
+// seek/flush leaves the render callback mounted and the unit running
+// (memo SS1.1, disassembly-proven, including the log string below).
+// Stock's stop() and its "can't stop audio unit" string -- absent
+// from the fork -- are gone with it.
+static void reset(struct ao *ao)
 {
     struct priv *p = ao->priv;
-    OSStatus err = AudioOutputUnitStop(p->audio_unit);
-    CHECK_CA_WARN("can't stop audio unit");
+
+    refresh_device_latency(ao);
+
+    OSStatus err = AudioUnitReset(p->audio_unit, 0, 0);
+    CHECK_CA_WARN("can't reset audio unit");
+
+    MP_VERBOSE(ao, "AudioUnit: reset without stop latency=%.1fms\n",
+               (double)p->device_latency_ns / 1e6);
+}
+
+// R-32 (fork audiounit port): set_pause is a NEW driver slot (stock
+// leaves it NULL, so pause falls back to reset/start and the core's
+// hw_paused bookkeeping and end_time re-anchor never engage; memo
+// SS1.2).  true stops the unit, false refreshes the latency reading
+// and starts it again -- the same sequences the fork runs.
+static bool set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    OSStatus err;
+
+    if (paused) {
+        err = AudioOutputUnitStop(p->audio_unit);
+        CHECK_CA_WARN("can't pause audio unit");
+    } else {
+        refresh_device_latency(ao);
+        err = AudioOutputUnitStart(p->audio_unit);
+        CHECK_CA_WARN("can't start audio unit");
+    }
+    // The fork returns its CHECK_CA_WARN helper's result here; for a
+    // pull-based AO the core ignores this return value (internal.h),
+    // so the constant carries no behaviour.
+    return true;
 }
 
